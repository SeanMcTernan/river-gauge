---
interface Props {
  chartData: any;
}

const { chartData } = Astro.props;
---

<!-- Plotly.js CDN - Using specific version (v2.35.2) -->
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<div class="flex gap-2">
  <div id="plotly-chart" class="flex-1 h-96"></div>
  <div id="chart-controls" class="flex flex-col gap-2"></div>
</div>

<style>
  /* Style the Plotly modebar to match dark theme */
  :global(.modebar) {
    position: relative !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    background: rgba(32, 32, 33, 0.8) !important;
    border-radius: 8px;
    padding: 8px;
    display: flex;
    flex-direction: column !important;
    gap: 4px;
  }
  
  :global(.modebar-group) {
    display: flex;
    flex-direction: column !important;
    gap: 4px;
    background: transparent !important;
  }
  
  :global(.modebar-btn) {
    color: #bdbdbd !important;
    margin: 2px 0 !important;
  }
  
  :global(.modebar-btn:hover) {
    background: rgba(51, 149, 173, 0.3) !important;
    color: #66cbea !important;
  }
  
  :global(.modebar-btn.active) {
    background: transparent !important;
    color: #e8eaed !important;
  }
  
  :global(.modebar-btn svg) {
    width: 20px;
    height: 20px;
  }
</style>

<script define:vars={{ chartData }}>
  console.log('Script loaded, chartData:', chartData);
  
  // Function to wait for Plotly and create chart
  function waitForPlotlyAndCreateChart() {
    console.log('Checking for Plotly...', typeof window.Plotly);
    
    if (typeof window.Plotly !== 'undefined') {
      console.log('Plotly found! Creating chart...');
      createChart();
    } else {
      console.log('Plotly not ready, waiting...');
      setTimeout(waitForPlotlyAndCreateChart, 200);
    }
  }
  
  function createChart() {
    try {
      console.log('Creating chart with data points:', chartData.x.length);
      
      // Set date range limits: September 1, 2025 to latest data point
      const minDate = new Date('2025-09-01T00:00:00Z');
      const maxDate = new Date(Math.max(...chartData.x.map(d => new Date(d).getTime())));
      const now = new Date();
      const latestDate = maxDate > now ? maxDate : now;
      
      // Calculate initial view: current week (7 days back from latest date)
      const oneWeekAgo = new Date(latestDate.getTime() - 7 * 24 * 60 * 60 * 1000);
      const initialStart = oneWeekAgo < minDate ? minDate : oneWeekAgo;
      
      const layout = {
        title: { text: '' },
        xaxis: { 
          title: 'Date & Time',
          color: '#bdbdbd',
          gridcolor: '#505459',
          fixedrange: false,
          range: [initialStart.toISOString(), latestDate.toISOString()],
          rangemode: 'normal'
        },
        yaxis: { 
          title: 'Water Level (cm)',
          color: '#bdbdbd',
          gridcolor: '#505459',
          fixedrange: false
        },
        plot_bgcolor: 'rgba(32, 32, 33, 0.4)',
        paper_bgcolor: 'transparent',
        font: { color: '#bdbdbd' },
        margin: { l: 60, r: 30, t: 30, b: 60 },
        hovermode: 'closest',
        dragmode: 'pan'
      };

      const config = {
        responsive: true,
        displayModeBar: true,
        displaylogo: false,
        scrollZoom: true,
        doubleClick: 'reset',
        modeBarButtonsToAdd: [],
        modeBarButtonsToRemove: ['select2d', 'lasso2d'],
        modeBarButtons: [
          [
            'zoom2d',
            'pan2d',
            'zoomIn2d',
            'zoomOut2d',
            'autoScale2d',
            'resetScale2d'
          ],
          ['toImage']
        ],
        toImageButtonOptions: {
          format: 'png',
          filename: 'water_level_chart',
          height: 600,
          width: 1200,
          scale: 2
        }
      };

      window.Plotly.newPlot('plotly-chart', [chartData], layout, config);
      console.log('✅ Chart created successfully!');
      
      // Enforce date range limits on pan/zoom
      const chartDiv = document.getElementById('plotly-chart');
      chartDiv.on('plotly_relayout', function(eventData) {
        if (eventData['xaxis.range[0]'] && eventData['xaxis.range[1]']) {
          const newStart = new Date(eventData['xaxis.range[0]']);
          const newEnd = new Date(eventData['xaxis.range[1]']);
          
          let needsUpdate = false;
          const updates = {};
          
          // Constrain to minimum date
          if (newStart < minDate) {
            updates['xaxis.range[0]'] = minDate.toISOString();
            needsUpdate = true;
          }
          
          // Constrain to maximum date
          if (newEnd > latestDate) {
            updates['xaxis.range[1]'] = latestDate.toISOString();
            needsUpdate = true;
          }
          
          if (needsUpdate) {
            window.Plotly.relayout('plotly-chart', updates);
          }
        }
      });
      
      // Move modebar to the right side
      setTimeout(() => {
        const modebar = document.querySelector('.modebar');
        const controlsContainer = document.getElementById('chart-controls');
        if (modebar && controlsContainer) {
          controlsContainer.appendChild(modebar);
          console.log('✅ Modebar moved to right side');
        }
      }, 100);
      
    } catch (error) {
      console.error('❌ Error creating chart:', error);
      const container = document.getElementById('plotly-chart');
      if (container) {
        container.innerHTML = '<p class="text-red-400 text-center">Chart Error: ' + error.message + '</p>';
      }
    }
  }
  
  // Start the process
  if (chartData && chartData.x && chartData.x.length > 0) {
    console.log('Chart data valid, starting...');
    waitForPlotlyAndCreateChart();
  } else {
    console.log('❌ No valid chart data');
    const container = document.getElementById('plotly-chart');
    if (container) {
      container.innerHTML = '<p class="text-primaryWhite text-center">No chart data available</p>';
    }
  }
</script>
