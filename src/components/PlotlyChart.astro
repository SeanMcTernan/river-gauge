---
interface Props {
  chartData: any;
}

const { chartData } = Astro.props;
---

<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>

<div class="flex gap-3">
  <div id="plotly-chart" class="flex-1 h-96 rounded-lg overflow-hidden"></div>
  <div id="chart-controls" class="flex flex-col gap-2"></div>
</div>

<style>
  :global(.modebar) {
    position: relative !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;
    background: rgba(22, 31, 48, 0.9) !important;
    border: 1px solid rgba(30, 41, 59, 0.8) !important;
    border-radius: 6px;
    padding: 6px;
    display: flex;
    flex-direction: column !important;
    gap: 2px;
  }

  :global(.modebar-group) {
    display: flex;
    flex-direction: column !important;
    gap: 2px;
    background: transparent !important;
  }

  :global(.modebar-btn) {
    color: #64748B !important;
    margin: 1px 0 !important;
  }

  :global(.modebar-btn:hover) {
    background: rgba(6, 182, 212, 0.15) !important;
    color: #06B6D4 !important;
  }

  :global(.modebar-btn.active) {
    background: transparent !important;
    color: #E2E8F0 !important;
  }

  :global(.modebar-btn svg) {
    width: 18px;
    height: 18px;
  }
</style>

<script define:vars={{ chartData }}>
  function waitForPlotlyAndCreateChart() {
    if (typeof window.Plotly !== 'undefined') {
      createChart();
    } else {
      setTimeout(waitForPlotlyAndCreateChart, 200);
    }
  }

  function createChart() {
    try {
      const minDate = new Date('2025-09-01T00:00:00Z');
      const maxDate = new Date(Math.max(...chartData.x.map(d => new Date(d).getTime())));
      const now = new Date();
      const latestDate = maxDate > now ? maxDate : now;
      const oneWeekAgo = new Date(latestDate.getTime() - 7 * 24 * 60 * 60 * 1000);
      const initialStart = oneWeekAgo < minDate ? minDate : oneWeekAgo;

      const layout = {
        title: { text: '' },
        xaxis: {
          title: { text: 'Date & Time (UTC)', font: { family: 'Inter, sans-serif', size: 12, color: '#64748B' } },
          color: '#64748B',
          gridcolor: 'rgba(30, 41, 59, 0.5)',
          linecolor: 'rgba(30, 41, 59, 0.8)',
          fixedrange: false,
          range: [initialStart.toISOString(), latestDate.toISOString()],
          rangemode: 'normal',
          tickfont: { family: 'JetBrains Mono, monospace', size: 10, color: '#64748B' }
        },
        yaxis: {
          title: { text: 'Water Level (cm)', font: { family: 'Inter, sans-serif', size: 12, color: '#64748B' } },
          color: '#64748B',
          gridcolor: 'rgba(30, 41, 59, 0.5)',
          linecolor: 'rgba(30, 41, 59, 0.8)',
          fixedrange: false,
          tickfont: { family: 'JetBrains Mono, monospace', size: 10, color: '#64748B' }
        },
        plot_bgcolor: 'rgba(17, 24, 39, 0.5)',
        paper_bgcolor: 'transparent',
        font: { family: 'Inter, sans-serif', color: '#E2E8F0' },
        margin: { l: 60, r: 30, t: 20, b: 60 },
        hovermode: 'closest',
        dragmode: 'pan',
        hoverlabel: {
          bgcolor: '#161F30',
          bordercolor: 'rgba(6, 182, 212, 0.3)',
          font: { family: 'JetBrains Mono, monospace', size: 12, color: '#E2E8F0' }
        }
      };

      const styledChartData = {
        ...chartData,
        line: { color: '#06B6D4', width: 2, shape: 'spline' },
        marker: { color: '#22D3EE', size: 4 },
        fill: 'tozeroy',
        fillcolor: 'rgba(6, 182, 212, 0.08)'
      };

      const config = {
        responsive: true,
        displayModeBar: true,
        displaylogo: false,
        scrollZoom: true,
        doubleClick: 'reset',
        modeBarButtonsToRemove: ['select2d', 'lasso2d'],
        modeBarButtons: [
          ['zoom2d', 'pan2d', 'zoomIn2d', 'zoomOut2d', 'autoScale2d', 'resetScale2d'],
          ['toImage']
        ],
        toImageButtonOptions: {
          format: 'png',
          filename: 'water_level_chart',
          height: 600,
          width: 1200,
          scale: 2
        }
      };

      const totalPoints = chartData.x.length;
      const animationSteps = 50;
      const pointsPerStep = Math.ceil(totalPoints / animationSteps);

      const initialData = {
        ...styledChartData,
        x: chartData.x.slice(0, 1),
        y: chartData.y.slice(0, 1)
      };

      window.Plotly.newPlot('plotly-chart', [initialData], layout, config).then(() => {
        let currentIndex = 1;
        const animationInterval = setInterval(() => {
          currentIndex += pointsPerStep;
          if (currentIndex >= totalPoints) {
            currentIndex = totalPoints;
            clearInterval(animationInterval);
          }
          window.Plotly.restyle('plotly-chart', {
            x: [chartData.x.slice(0, currentIndex)],
            y: [chartData.y.slice(0, currentIndex)]
          });
        }, 30);
      });

      const chartDiv = document.getElementById('plotly-chart');
      chartDiv.addEventListener('wheel', function(e) {
        if (!e.ctrlKey) { e.preventDefault(); }
      }, { passive: false });

      chartDiv.on('plotly_relayout', function(eventData) {
        if (eventData['xaxis.range[0]'] && eventData['xaxis.range[1]']) {
          const newStart = new Date(eventData['xaxis.range[0]']);
          const newEnd = new Date(eventData['xaxis.range[1]']);
          let needsUpdate = false;
          const updates = {};
          if (newStart < minDate) { updates['xaxis.range[0]'] = minDate.toISOString(); needsUpdate = true; }
          if (newEnd > latestDate) { updates['xaxis.range[1]'] = latestDate.toISOString(); needsUpdate = true; }
          if (needsUpdate) { window.Plotly.relayout('plotly-chart', updates); }
        }
      });

      setTimeout(() => {
        const modebar = document.querySelector('.modebar');
        const controlsContainer = document.getElementById('chart-controls');
        if (modebar && controlsContainer) { controlsContainer.appendChild(modebar); }
      }, 100);

    } catch (error) {
      const container = document.getElementById('plotly-chart');
      if (container) {
        container.innerHTML = '<p class="text-danger text-center font-body">Chart Error: ' + error.message + '</p>';
      }
    }
  }

  if (chartData && chartData.x && chartData.x.length > 0) {
    waitForPlotlyAndCreateChart();
  } else {
    const container = document.getElementById('plotly-chart');
    if (container) {
      container.innerHTML = '<p class="text-textMuted text-center font-body">No chart data available</p>';
    }
  }
</script>
