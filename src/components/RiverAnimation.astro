---
// Animated tech background - data stream visualization
---

<div id="tech-bg" class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
  <!-- Animated circuit-like SVG layers -->
  <svg class="data-layer data-layer-1" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="stream1" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="rgba(6,182,212,0)" />
        <stop offset="50%" stop-color="rgba(6,182,212,0.12)" />
        <stop offset="100%" stop-color="rgba(6,182,212,0)" />
      </linearGradient>
    </defs>
    <g fill="none" stroke-linecap="round">
      <path d="M-100 300 L200 300 L220 280 L400 280 L420 300 L700 300 L720 320 L900 320 L920 300 L1300 300" stroke="url(#stream1)" stroke-width="1" />
      <path d="M-100 500 L150 500 L170 480 L350 480 L370 500 L650 500 L670 520 L850 520 L870 500 L1300 500" stroke="rgba(6,182,212,0.06)" stroke-width="0.8" />
      <path d="M-100 200 L250 200 L270 220 L450 220 L470 200 L750 200 L770 180 L950 180 L970 200 L1300 200" stroke="rgba(6,182,212,0.04)" stroke-width="0.6" />
    </g>
  </svg>

  <svg class="data-layer data-layer-2" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <g fill="none" stroke-linecap="round">
      <path d="M-100 400 L100 400 L120 380 L300 380 L320 400 L600 400 L620 420 L800 420 L820 400 L1300 400" stroke="rgba(16,185,129,0.06)" stroke-width="0.8" />
      <path d="M-100 600 L200 600 L220 580 L400 580 L420 600 L700 600 L720 620 L900 620 L920 600 L1300 600" stroke="rgba(16,185,129,0.04)" stroke-width="0.6" />
    </g>
  </svg>

  <!-- Floating data nodes -->
  <svg class="data-layer data-layer-3" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <circle cx="200" cy="300" r="2" fill="rgba(6,182,212,0.2)">
      <animate attributeName="opacity" values="0.1;0.4;0.1" dur="3s" repeatCount="indefinite" />
    </circle>
    <circle cx="500" cy="450" r="1.5" fill="rgba(6,182,212,0.15)">
      <animate attributeName="opacity" values="0.1;0.3;0.1" dur="4s" repeatCount="indefinite" />
    </circle>
    <circle cx="800" cy="250" r="2" fill="rgba(6,182,212,0.2)">
      <animate attributeName="opacity" values="0.1;0.5;0.1" dur="2.5s" repeatCount="indefinite" />
    </circle>
    <circle cx="1000" cy="500" r="1.5" fill="rgba(16,185,129,0.15)">
      <animate attributeName="opacity" values="0.1;0.3;0.1" dur="3.5s" repeatCount="indefinite" />
    </circle>
    <circle cx="350" cy="600" r="1.5" fill="rgba(6,182,212,0.15)">
      <animate attributeName="opacity" values="0.1;0.35;0.1" dur="4.5s" repeatCount="indefinite" />
    </circle>
  </svg>

  <!-- Grid overlay -->
  <div class="grid-overlay"></div>
</div>

<style>
  #tech-bg {
    background:
      radial-gradient(ellipse at 20% 50%, rgba(6, 182, 212, 0.05) 0%, transparent 60%),
      radial-gradient(ellipse at 80% 20%, rgba(16, 185, 129, 0.03) 0%, transparent 50%),
      radial-gradient(ellipse at 50% 80%, rgba(6, 182, 212, 0.02) 0%, transparent 40%);
  }

  .data-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .data-layer-1 {
    animation: layerShift1 20s ease-in-out infinite;
  }

  .data-layer-2 {
    animation: layerShift2 25s ease-in-out infinite;
  }

  .data-layer-3 {
    animation: layerShift3 15s ease-in-out infinite;
  }

  @keyframes layerShift1 {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(15px); }
  }

  @keyframes layerShift2 {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-10px); }
  }

  @keyframes layerShift3 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .data-layer path {
    stroke-dasharray: 12 8;
    animation: dataStream 3s linear infinite;
  }

  .data-layer-2 path {
    stroke-dasharray: 8 12;
    animation-duration: 5s;
    animation-direction: reverse;
  }

  @keyframes dataStream {
    to { stroke-dashoffset: -40; }
  }

  .grid-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.015;
    background-image:
      linear-gradient(rgba(6, 182, 212, 1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(6, 182, 212, 1) 1px, transparent 1px);
    background-size: 80px 80px;
  }
</style>
