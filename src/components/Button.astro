---
interface Props {
  urlPath: string;
  text: string;
  newAttributes?: string;
}

const { urlPath, text, newAttributes } = Astro.props;
const defaultClass = "inline-flex items-center gap-2 font-body text-sm font-medium px-6 py-3 border border-accent/30 text-accent hover:bg-accent/10 hover:border-accent/60 rounded-lg transition-all duration-300";
const finalClass = newAttributes ? `${defaultClass} ${newAttributes}` : defaultClass;
---

<a href={urlPath} class={finalClass}>
  {text}
  <svg viewBox="0 0 16 16" class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M3 8h10M9 4l4 4-4 4" />
  </svg>
</a>
