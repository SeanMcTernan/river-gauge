---
export const prerender = false;

import Layout from '../layouts/Layout.astro';

// Fetch real data for Wigwam River
let wigwamData = {
  name: "Wigwam River",
  slug: "wigwam",
  level: "---",
  levelNum: 0,
  status: "Unknown",
  statusColor: "gray",
  percentage: 0,
  updated: "Loading...",
};

try {
  const context = import.meta.env.CONTEXT || 'production';
  const apiUrl = context === 'dev' ? 'http://localhost:8888' : 'https://digitalflowgauge.com';
  const response = await fetch(`${apiUrl}/historicallevels?wigwam`);
  if (response.ok) {
    const data = await response.json();
    if (data?.data && typeof data.data === 'object') {
      const readings: { date: Date, level: number }[] = [];

      for (const year in data.data) {
        for (const month in data.data[year]) {
          for (const date in data.data[year][month]) {
            for (const hour in data.data[year][month][date]) {
              const level = data.data[year][month][date][hour];
              const dateTime = `${date} ${hour}:00`;
              readings.push({
                date: new Date(dateTime),
                level: typeof level === 'number' ? level : parseInt(level.toString())
              });
            }
          }
        }
      }

      if (readings.length > 0) {
        readings.sort((a, b) => a.date.getTime() - b.date.getTime());
        const currentLevel = readings[readings.length - 1].level;

        let status, statusColor;
        if (currentLevel > 150) {
          status = "High";
          statusColor = "high";
        } else if (currentLevel >= 100) {
          status = "Running";
          statusColor = "running";
        } else {
          status = "Low";
          statusColor = "low";
        }

        wigwamData = {
          name: "Wigwam River",
          slug: "wigwam",
          level: `${currentLevel}`,
          levelNum: currentLevel,
          status: status,
          statusColor: statusColor,
          percentage: Math.min((currentLevel / 200) * 100, 100),
          updated: "Just now",
        };
      }
    }
  }
} catch (error) {
  console.error('Error fetching Wigwam data:', error);
}

const riverData = [wigwamData];
---

<Layout
  pageTitle="Current Levels"
  pageDescription="Real-time water levels for all monitored river gauge stations."
>
  <div class="scan-pattern min-h-screen">
    <div class="max-w-6xl mx-auto px-6 py-16">

      <!-- Page header -->
      <div class="mb-16 animate-fade-up">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent/10 border border-accent/20 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span class="font-mono text-xs text-accent">Sensor Network</span>
        </div>
        <h1 class="font-display text-4xl lg:text-5xl font-bold text-text tracking-tight mb-4">
          Live Sensor Data
        </h1>
        <p class="font-body text-lg text-textMuted max-w-2xl">
          Real-time monitoring data from active IoT gauge stations across the Canadian Rockies.
        </p>
      </div>

      <!-- Status Legend -->
      <div class="mb-12 animate-fade-up delay-1">
        <div class="flex items-center gap-8 font-mono text-xs">
          <span class="text-textDim">Status:</span>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-warning"></span>
            <span class="text-textMuted">Low</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-signal"></span>
            <span class="text-textMuted">Running</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-danger"></span>
            <span class="text-textMuted">High</span>
          </div>
        </div>
      </div>

      <!-- River Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {riverData.map((river, index) => (
          <a href={`/river/${river.slug}`} class="block group animate-fade-up delay-2">
            <div class="card p-8 relative overflow-hidden h-full">
              <!-- Top glow line -->
              <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/30 to-transparent"></div>

              <!-- Header -->
              <div class="flex items-start justify-between mb-6">
                <div>
                  <p class="font-mono text-[10px] text-textDim mb-1">SENSOR-001</p>
                  <h3 class="font-display text-xl font-semibold text-text">{river.name}</h3>
                </div>
                <span class={`font-mono text-[10px] px-2.5 py-1 rounded-md border ${
                  river.statusColor === 'running' ? 'status-bg-running status-running' :
                  river.statusColor === 'low' ? 'status-bg-low status-low' :
                  river.statusColor === 'high' ? 'status-bg-high status-high' :
                  'bg-surfaceHover text-textDim border-border'
                }`}>
                  {river.status}
                </span>
              </div>

              <!-- Level -->
              <div class="mb-6">
                <span class={`font-mono text-5xl font-medium tracking-tight ${
                  river.statusColor === 'running' ? 'text-signal' :
                  river.statusColor === 'low' ? 'text-warning' :
                  river.statusColor === 'high' ? 'text-danger' :
                  'text-textMuted'
                }`}>
                  {river.level}
                </span>
                <span class="font-body text-sm text-textMuted ml-1">cm</span>
              </div>

              <!-- Bar -->
              <div class="mb-4">
                <div class="level-bar">
                  <div
                    class={`level-bar-fill ${
                      river.statusColor === 'running' ? 'bg-signal' :
                      river.statusColor === 'low' ? 'bg-warning' :
                      river.statusColor === 'high' ? 'bg-danger' :
                      'bg-textDim'
                    }`}
                    style={`width: ${river.percentage}%`}
                  ></div>
                </div>
              </div>

              <!-- Footer -->
              <div class="border-t border-border pt-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-signal animate-pulse"></span>
                  <span class="font-mono text-[10px] text-textDim">Updated {river.updated}</span>
                </div>
                <span class="font-body text-xs font-medium text-accent group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  View
                  <svg viewBox="0 0 16 16" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Auto-refresh Notice -->
      <div class="mt-12 text-center animate-fade-up delay-4">
        <p class="font-mono text-xs text-textDim">
          Auto-refresh interval: 300s
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  setInterval(() => {
    window.location.reload();
  }, 5 * 60 * 1000);
</script>
