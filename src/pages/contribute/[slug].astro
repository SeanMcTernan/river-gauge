---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import { getCollection } from 'astro:content';
import { PAYMENT_OPTIONS } from '../../config/stripe';

// Get the slug from the URL
const { slug } = Astro.params;

// Load all projects to find matching slug
const allProjects = await getCollection('projects');
const project = allProjects.find(p => p.slug === slug);

if (!project) {
  return Astro.redirect('/contribute');
}

const { name: gaugeName, location, funding, coordinates } = project.data;
const fundingGoal = funding.goal;

// Render the markdown content
const { Content } = await project.render();

// TODO: Fetch current funding from Stripe API
let currentFunding = 0; // Placeholder - will be API call to Stripe

// Calculate funding progress
const fundingPercentage = Math.min((currentFunding / fundingGoal) * 100, 100);
const remainingFunding = fundingGoal - currentFunding;
---

<Layout
  pageTitle={`${gaugeName} - Fundraising Project`}
  pageDescription={`Help us install a river gauge on ${gaugeName}. Location: ${location}`}
>
  <!-- Static mesh background layer -->
  <div class="mesh-background-full"></div>

  <main class="flex-grow relative">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a
        href="/contribute"
        class="inline-flex items-center text-primaryTeal hover:text-primaryBlue transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Contribute
      </a>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto">
      <!-- Project Header -->
      <div class="text-center mb-12">
        <div class="inline-block px-4 py-2 bg-blue-500/20 text-blue-300 rounded-full text-sm font-medium mb-4">
          Fundraising Project
        </div>
        <h1 class="text-4xl lg:text-6xl font-bold text-primaryWhite mb-4">
          {gaugeName}
        </h1>
        <p class="text-xl text-primaryWhite">
          Help us bring real-time water level monitoring to Toby Creek
        </p>
      </div>

      <!-- Funding Progress Card -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-8 border border-primaryTeal/30 mb-8">
        <h2 class="text-white font-semibold text-2xl mb-6 text-center">Funding Progress</h2>

        <div class="mb-6">
          <div class="flex justify-between items-baseline mb-2">
            <span class="text-primaryWhite text-lg">Raised</span>
            <span class="text-primaryTeal text-3xl font-bold">${currentFunding}</span>
          </div>
          <div class="flex justify-between items-baseline mb-4">
            <span class="text-primaryWhite/70 text-sm">Goal</span>
            <span class="text-primaryWhite text-xl">${fundingGoal}</span>
          </div>

          <!-- Progress Bar -->
          <div class="h-4 bg-secondaryGray rounded-full overflow-hidden mb-4">
            <div
              class="h-full bg-gradient-to-r from-primaryTeal to-primaryBlue rounded-full transition-all duration-500"
              style={`width: ${fundingPercentage}%`}
            ></div>
          </div>

          <p class="text-center text-primaryWhite">
            <span class="text-2xl font-bold text-primaryTeal">{fundingPercentage.toFixed(0)}%</span> funded
            {remainingFunding > 0 && (
              <span class="text-sm text-primaryWhite/70 block mt-1">
                ${remainingFunding} remaining to reach our goal
              </span>
            )}
          </p>
        </div>
      </div>

      <!-- Contribution Options -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-8 border border-primaryTeal/30 mb-8">
        <h2 class="text-white font-semibold text-2xl mb-6 text-center">Choose Your Contribution</h2>
        <p class="text-primaryWhite text-center mb-8">
          Select a contribution option to help fund this gauge installation
        </p>

        <!-- Payment Options Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {PAYMENT_OPTIONS.map((option) => (
            <div
              class={`payment-option bg-primaryGray/60 backdrop-blur-sm rounded-xl p-6 border transition-all duration-300 hover:transform hover:scale-105 cursor-pointer relative ${
                option.popular
                  ? 'border-primaryTeal shadow-lg shadow-primaryTeal/20'
                  : 'border-primaryWhite/20 hover:border-primaryTeal/50'
              }`}
              data-option-id={option.id}
              data-price-id={option.priceId}
              data-type={option.type}
              data-amount={option.amount}
            >
              {option.popular && (
                <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                  <span class="bg-primaryTeal text-white px-3 py-1 rounded-full text-xs font-semibold">
                    POPULAR
                  </span>
                </div>
              )}

              <div class="text-center mb-4">
                <h3 class="text-white font-semibold text-xl mb-1">{option.name}</h3>
                <p class="text-primaryWhite/70 text-xs">{option.description}</p>
              </div>

              {option.amount === 'custom' ? (
                <div class="mb-4">
                  <label class="block text-primaryWhite text-xs mb-2">
                    {option.type === 'recurring' ? 'Annual Amount' : 'Amount'}
                  </label>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 transform -translate-y-1/2 text-primaryWhite text-lg">
                      $
                    </span>
                    <input
                      type="number"
                      min="1"
                      step="1"
                      placeholder="Enter amount"
                      class="custom-amount-input w-full bg-secondaryGray text-white text-lg pl-7 pr-3 py-2 rounded-lg border border-primaryWhite/20 focus:border-primaryTeal focus:outline-none"
                      data-option={option.id}
                    />
                  </div>
                </div>
              ) : (
                <div class="text-center mb-4">
                  <div class="text-4xl font-bold text-primaryTeal mb-1">
                    ${option.amount}
                  </div>
                  <div class="text-primaryWhite/70 text-xs">
                    {option.type === 'recurring' ? 'per year' : 'one-time'}
                  </div>
                </div>
              )}

              <button
                class="select-payment-btn w-full bg-primaryTeal hover:bg-primaryBlue text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200 text-sm"
                data-option={option.id}
              >
                {option.type === 'recurring' ? 'Subscribe' : 'Contribute'}
              </button>

              {option.type === 'recurring' && (
                <p class="text-xs text-primaryWhite/50 text-center mt-2">
                  Cancel anytime
                </p>
              )}
            </div>
          ))}
        </div>

        <!-- Secure Payment Info -->
        <div class="mt-8 text-center">
          <div class="flex justify-center items-center space-x-2 text-primaryWhite/70 text-xs">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Secure payments powered by Stripe</span>
          </div>
        </div>
      </div>

      <!-- Project Description -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-8 border border-primaryWhite/20 mb-8">
        <h2 class="text-white font-semibold text-2xl mb-4">About This Project</h2>
        <div class="space-y-4 text-primaryWhite prose prose-invert prose-p:text-primaryWhite max-w-none">
          <Content />

          <div class="bg-primaryGray/40 rounded-lg p-4 border border-primaryWhite/10 not-prose">
            <h3 class="text-primaryTeal font-semibold mb-2">Installation Location</h3>
            <p class="text-primaryWhite">{location}</p>
          </div>
        </div>
      </div>

      <!-- What Your Contribution Supports -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-8 border border-primaryWhite/20 mb-8">
        <h2 class="text-white font-semibold text-2xl mb-6">What Your Contribution Supports</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primaryTeal/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primaryTeal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Gauge Equipment</h3>
              <p class="text-primaryWhite text-sm">
                High-quality sensors and hardware for accurate water level measurement
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primaryTeal/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primaryTeal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Data Transmission</h3>
              <p class="text-primaryWhite text-sm">
                Cellular connectivity for real-time data updates
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primaryTeal/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primaryTeal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Installation</h3>
              <p class="text-primaryWhite text-sm">
                Professional installation and calibration at the monitoring site
              </p>
            </div>
          </div>

          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0 w-12 h-12 bg-primaryTeal/20 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primaryTeal" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Ongoing Maintenance</h3>
              <p class="text-primaryWhite text-sm">
                Regular upkeep and calibration to ensure accurate readings
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Location Map -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-8 border border-primaryWhite/20 mb-8">
        <h2 class="text-2xl font-bold text-primaryWhite mb-6 text-center">Proposed Gauge Location</h2>
        <div class="mb-4 bg-primaryGray/40 rounded-lg p-4 border border-primaryWhite/10">
          <p class="text-primaryWhite text-center">
            <span class="font-semibold text-primaryTeal">Location:</span> {location}
          </p>
        </div>
        <div id="map" class="w-full h-96 rounded-xl overflow-hidden"></div>
      </div>

      <!-- Call to Action -->
      <div class="bg-gradient-to-r from-primaryTeal/20 to-primaryBlue/20 backdrop-blur-sm rounded-2xl p-8 border border-primaryTeal/30 text-center">
        <h2 class="text-white font-semibold text-2xl mb-4">Help Make This Happen</h2>
        <p class="text-primaryWhite mb-6 max-w-2xl mx-auto">
          Every contribution brings us closer to providing free, real-time water level data
          for the Toby Creek community. Together, we can make waterways safer and more accessible for everyone.
        </p>
        <Button urlPath="/contribute" text="Support This Project" />
      </div>
    </div>
  </main>
</Layout>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  // Handle payment selection
  document.addEventListener('DOMContentLoaded', () => {
    const selectButtons = document.querySelectorAll('.select-payment-btn');

    selectButtons.forEach(button => {
      button.addEventListener('click', async (e) => {
        const target = e.target as HTMLButtonElement;
        const optionId = target.dataset.option;
        const paymentOption = document.querySelector(`[data-option-id="${optionId}"]`);

        if (!paymentOption) return;

        const priceId = paymentOption.getAttribute('data-price-id');
        const type = paymentOption.getAttribute('data-type');
        const amount = paymentOption.getAttribute('data-amount');

        // Determine the final amount
        let finalAmount: number | null = null;
        if (amount === 'custom') {
          // Get custom amount from input
          const input = paymentOption.querySelector('.custom-amount-input') as HTMLInputElement;
          finalAmount = parseInt(input.value);

          if (!finalAmount || finalAmount < 1) {
            alert('Please enter a valid amount');
            return;
          }
        } else {
          // Use fixed amount from data attribute
          finalAmount = parseInt(amount);
        }

        // Disable button and show loading
        target.disabled = true;
        target.textContent = 'Loading...';

        try {
          // Build checkout URL with query parameters
          const checkoutUrl = new URL('/checkout', window.location.origin);
          checkoutUrl.searchParams.set('priceId', priceId);
          checkoutUrl.searchParams.set('type', type);
          checkoutUrl.searchParams.set('project', window.location.pathname.split('/').pop());
          checkoutUrl.searchParams.set('amount', finalAmount.toString());

          // Navigate to embedded checkout page
          window.location.href = checkoutUrl.toString();
        } catch (error) {
          console.error('Error:', error);
          alert('Failed to start checkout. Please try again.');
          target.disabled = false;
          target.textContent = type === 'recurring' ? 'Subscribe' : 'Contribute';
        }
      });
    });
  });
</script>

<script define:vars={{ coordinates, gaugeName }}>
  // Initialize map when Leaflet is loaded
  function initMap() {
    if (typeof L !== 'undefined') {
      const map = L.map('map').setView([coordinates.lat, coordinates.lng], 13);

      // Add OpenStreetMap tiles
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        maxZoom: 19
      }).addTo(map);

      // Add marker at gauge location
      const marker = L.marker([coordinates.lat, coordinates.lng]).addTo(map);
      marker.bindPopup(`<div style="text-align: center;"><span style="color: #66cbea; font-weight: bold; font-size: 16px;">${gaugeName} Gauge</span><br><span style="color: #bdbdbd;">Proposed Location</span></div>`).openPopup();
    } else {
      setTimeout(initMap, 100);
    }
  }

  // Wait for DOM to be ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>

<style>
  /* Map dark theme styling */
  #map {
    background-color: #202021 !important;
  }

  /* Style map controls */
  :global(.leaflet-control-zoom a) {
    background-color: rgba(32, 32, 33, 0.9) !important;
    color: #3395ad !important;
    border: 1px solid rgba(51, 149, 173, 0.3) !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background-color: rgba(51, 149, 173, 0.3) !important;
    color: #66cbea !important;
  }

  /* Style popup */
  :global(.leaflet-popup-content-wrapper) {
    background-color: rgba(32, 32, 33, 0.95) !important;
    color: #e8eaed !important;
    border: 1px solid rgba(51, 149, 173, 0.3) !important;
    border-radius: 8px !important;
  }

  :global(.leaflet-popup-tip) {
    background-color: rgba(32, 32, 33, 0.95) !important;
  }

  :global(.leaflet-popup-close-button) {
    color: #e8eaed !important;
  }

  :global(.leaflet-popup-close-button:hover) {
    color: #3395ad !important;
  }

  /* Attribution styling */
  :global(.leaflet-control-attribution) {
    background-color: rgba(32, 32, 33, 0.8) !important;
    color: #bdbdbd !important;
  }

  :global(.leaflet-control-attribution a) {
    color: #3395ad !important;
  }

  /* Full-page mesh background */
  .mesh-background-full {
    position: fixed;
    inset: 0;
    min-height: 100vh;
    background-color: rgba(51, 149, 173, 0.09);
    background-image:
      linear-gradient(rgba(51, 149, 173, 0.15) 1px, transparent 1px),
      linear-gradient(90deg, rgba(51, 149, 173, 0.15) 1px, transparent 1px);
    background-size: 20px 20px;
    z-index: -20;
    pointer-events: none;
  }

  /* Gradient fade overlay to fade mesh at top and bottom */
  .mesh-background-full::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      linear-gradient(to bottom, #202021 0%, rgba(32, 32, 33, 0.95) 20%, rgba(32, 32, 33, 0.7) 40%, transparent 50%, transparent 50%, rgba(32, 32, 33, 0.7) 60%, rgba(32, 32, 33, 0.95) 80%, #202021 100%),
      linear-gradient(to right, #202021 0%, rgba(32, 32, 33, 0.8) 1%, transparent 4%, transparent 96%, rgba(32, 32, 33, 0.8) 99%, #202021 100%);
    pointer-events: none;
    z-index: 0;
  }

  /* Custom input number styling */
  input[type="number"]::-webkit-inner-spin-button,
  input[type="number"]::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  input[type="number"] {
    -moz-appearance: textfield;
  }
</style>
