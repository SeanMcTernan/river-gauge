---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Button from "../components/Button.astro";
import RiverAnimation from "../components/RiverAnimation.astro";

// Fetch real data for Wigwam River
let wigwamData = {
  level: "---",
  levelNum: 0,
  status: "Unknown",
  statusColor: "gray",
  percentage: 0,
};

try {
  const context = import.meta.env.CONTEXT || 'production';
  const apiUrl = context === 'dev' ? 'http://localhost:8888' : 'https://digitalflowgauge.com';
  const response = await fetch(`${apiUrl}/historicallevels?wigwam`);
  if (response.ok) {
    const data = await response.json();
    if (data?.data && typeof data.data === 'object') {
      const readings: { date: Date, level: number }[] = [];

      for (const year in data.data) {
        for (const month in data.data[year]) {
          for (const date in data.data[year][month]) {
            for (const hour in data.data[year][month][date]) {
              const level = data.data[year][month][date][hour];
              const dateTime = `${date} ${hour}:00`;
              readings.push({
                date: new Date(dateTime),
                level: typeof level === 'number' ? level : parseInt(level.toString())
              });
            }
          }
        }
      }

      if (readings.length > 0) {
        readings.sort((a, b) => a.date.getTime() - b.date.getTime());
        const currentLevel = readings[readings.length - 1].level;

        let status, statusColor;
        if (currentLevel > 150) {
          status = "High";
          statusColor = "high";
        } else if (currentLevel >= 100) {
          status = "Running";
          statusColor = "running";
        } else {
          status = "Low";
          statusColor = "low";
        }

        wigwamData = {
          level: `${currentLevel}`,
          levelNum: currentLevel,
          status: status,
          statusColor: statusColor,
          percentage: Math.min((currentLevel / 200) * 100, 100),
        };
      }
    }
  }
} catch (error) {
  console.error('Error fetching Wigwam data:', error);
}
---

<Layout
  pageTitle="Home"
  pageDescription="Real-time river gauge monitoring system providing accurate water level data for safety and planning."
>
  <RiverAnimation />

  <div class="relative min-h-[calc(100vh-80px)] flex items-center">
    <div class="max-w-6xl mx-auto px-6 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

        <!-- Left: Hero content -->
        <div class="lg:col-span-7 pt-12 lg:pt-0">
          <div class="animate-fade-up">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent/10 border border-accent/20 mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
              <span class="font-mono text-xs text-accent">Real-time IoT Monitoring</span>
            </div>
          </div>

          <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-text leading-[1.05] tracking-tight animate-fade-up delay-1">
            Smart river<br/>
            <span class="text-accent">sensor network</span>
          </h1>

          <p class="font-body text-lg text-textMuted mt-8 mb-10 max-w-xl leading-relaxed animate-fade-up delay-2">
            Satellite-linked IoT gauges monitor water levels in real-time across rivers in the Canadian Rockies.
            Data transmitted every 12 hours for safety analytics and conservation.
          </p>

          <div class="animate-fade-up delay-3">
            <Button urlPath="/levels" text="View Live Data" />
          </div>

          <!-- Tech metadata -->
          <div class="mt-16 flex items-center gap-6 text-textDim animate-fade-up delay-5">
            <span class="font-mono text-xs">49.28&deg;N</span>
            <span class="w-8 h-px bg-accent/20"></span>
            <span class="font-mono text-xs">114.95&deg;W</span>
            <span class="w-8 h-px bg-accent/20"></span>
            <span class="font-mono text-xs">Elk Valley, BC</span>
          </div>
        </div>

        <!-- Right: River gauge card -->
        <div class="lg:col-span-5 animate-fade-up delay-4">
          <a href="/river/wigwam" class="block group">
            <div class="card p-8 relative overflow-hidden">
              <!-- Accent glow on top -->
              <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

              <!-- Header -->
              <div class="flex items-start justify-between mb-8">
                <div>
                  <p class="font-mono text-[10px] text-textDim mb-1">SENSOR-001</p>
                  <h3 class="font-display text-2xl font-semibold text-text">Wigwam River</h3>
                </div>
                <span class={`font-mono text-xs px-3 py-1.5 rounded-md border ${
                  wigwamData.statusColor === 'running' ? 'status-bg-running status-running' :
                  wigwamData.statusColor === 'low' ? 'status-bg-low status-low' :
                  wigwamData.statusColor === 'high' ? 'status-bg-high status-high' :
                  'bg-surfaceHover text-textDim border-border'
                }`}>
                  {wigwamData.status}
                </span>
              </div>

              <!-- Big level display -->
              <div class="text-center py-6">
                <span class={`font-mono text-7xl font-medium tracking-tight ${
                  wigwamData.statusColor === 'running' ? 'text-signal' :
                  wigwamData.statusColor === 'low' ? 'text-warning' :
                  wigwamData.statusColor === 'high' ? 'text-danger' :
                  'text-textMuted'
                }`}>
                  {wigwamData.level}
                </span>
                <span class="font-body text-lg text-textMuted ml-2">cm</span>
              </div>

              <!-- Level bar -->
              <div class="mt-4 mb-6">
                <div class="level-bar">
                  <div
                    class={`level-bar-fill ${
                      wigwamData.statusColor === 'running' ? 'bg-signal' :
                      wigwamData.statusColor === 'low' ? 'bg-warning' :
                      wigwamData.statusColor === 'high' ? 'bg-danger' :
                      'bg-textDim'
                    }`}
                    style={`width: ${wigwamData.percentage}%`}
                  ></div>
                </div>
                <div class="flex justify-between mt-2">
                  <span class="font-mono text-[10px] text-textDim">0 cm</span>
                  <span class="font-mono text-[10px] text-textDim">200 cm</span>
                </div>
              </div>

              <!-- Footer -->
              <div class="border-t border-border pt-4 flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-signal animate-pulse"></span>
                  <span class="font-mono text-[10px] text-textDim">Satellite uplink active</span>
                </div>
                <span class="font-body text-xs font-medium text-accent group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Details
                  <svg viewBox="0 0 16 16" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
