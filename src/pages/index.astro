---
import Layout from '../layouts/Layout.astro';
---

<Layout title="River Gauge Monitor - Real-time Water Level Monitoring">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-white">
    <div class="absolute inset-0 bg-gradient-to-br from-purple-50 via-white to-purple-50"></div>
    <div class="relative max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="max-w-4xl mx-auto text-center">
        <div class="mb-8">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-purple-100 text-purple-800 mb-6">
            New: Real-time monitoring
          </span>
        </div>
        <h1 class="text-5xl lg:text-7xl font-bold text-gray-900 mb-6 tracking-tight">
          Monitor water levels
          <span class="bg-gradient-to-r from-purple-600 to-purple-800 bg-clip-text text-transparent">
            in real-time
          </span>
        </h1>
        <p class="text-xl lg:text-2xl text-gray-600 mb-12 max-w-3xl mx-auto leading-relaxed">
          Streamline river monitoring, safety alerts, and historical analysis. Purpose-built for modern water management.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <button class="bg-purple-600 hover:bg-purple-700 text-white px-8 py-4 rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg hover:shadow-xl">
            Start monitoring
          </button>
          <a href="/historical" class="text-gray-600 hover:text-gray-900 px-8 py-4 rounded-lg font-semibold transition-colors flex items-center">
            View historical data
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-20">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Made for modern water management
        </h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Set the monitoring direction. Manage projects end-to-end. Build momentum with real-time data.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Real-time Monitoring -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Real-time monitoring</h3>
          <p class="text-gray-600 leading-relaxed">
            Get up-to-the-minute water level readings from multiple river gauge stations with automatic updates.
          </p>
        </div>

        <!-- Historical Analysis -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Historical insights</h3>
          <p class="text-gray-600 leading-relaxed">
            Analyze patterns and trends to understand seasonal variations and make informed decisions.
          </p>
        </div>

        <!-- Alerts & Safety -->
        <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Smart alerts</h3>
          <p class="text-gray-600 leading-relaxed">
            Receive intelligent notifications about flood warnings and critical water level changes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Status Section -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Powering water management teams
        </h2>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          From emergency response to long-term planning. See how teams use River Gauge.
        </p>
      </div>
      
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Sample River Cards -->
        <div class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-purple-200 hover:shadow-lg transition-all duration-200">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900">Wigwam River</h3>
            </div>
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">Normal</span>
          </div>
          <div class="mb-4">
            <div class="text-3xl font-bold text-gray-900 mb-1">4.2 ft</div>
            <p class="text-sm text-gray-500">Updated 5 minutes ago</p>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-green-400 to-green-500 rounded-full" style="width: 42%"></div>
          </div>
        </div>

        <div class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-purple-200 hover:shadow-lg transition-all duration-200">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900">Pine Creek</h3>
            </div>
            <span class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-sm font-medium">Watch</span>
          </div>
          <div class="mb-4">
            <div class="text-3xl font-bold text-gray-900 mb-1">6.8 ft</div>
            <p class="text-sm text-gray-500">Updated 3 minutes ago</p>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-yellow-400 to-yellow-500 rounded-full" style="width: 68%"></div>
          </div>
        </div>

        <div class="group bg-white rounded-2xl border border-gray-200 p-6 hover:border-purple-200 hover:shadow-lg transition-all duration-200">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center space-x-3">
              <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-gray-900">Mill River</h3>
            </div>
            <span class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-sm font-medium">Normal</span>
          </div>
          <div class="mb-4">
            <div class="text-3xl font-bold text-gray-900 mb-1">3.1 ft</div>
            <p class="text-sm text-gray-500">Updated 2 minutes ago</p>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-full bg-gradient-to-r from-green-400 to-green-500 rounded-full" style="width: 31%"></div>
          </div>
        </div>
      </div>

      <div class="text-center mt-16">
        <button class="bg-purple-600 hover:bg-purple-700 text-white px-8 py-3 rounded-lg font-semibold transition-colors shadow-sm">
          View all river levels
        </button>
      </div>
    </div>
  </section>
</Layout>
