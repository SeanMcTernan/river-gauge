---
import Layout from '../layouts/Layout.astro';
import Button from "../components/Button.astro";
---

<Layout
  pageTitle="Home"
  pageDescription="Real-time river gauge monitoring system providing accurate water level data for safety and planning."
>
  <main class="flex-grow grid grid-cols-1 md:grid-cols-2 gap-4 h-full">
    <div
      class="flex flex-col justify-center items-start lg:items-end p-4 lg:mt-[-10rem] h-full"
    >
      <div class="max-w-lg lg:mr-0 mt-40">
        <h1 class="text-white font-medium leading-tight text-4xl">
          Real-time River Gauge Monitoring
        </h1>
        <p class="text-primaryWhite mt-4 mb-10">
          Monitor water levels in real-time with our advanced river gauge system. Get accurate data for safety alerts, flood warnings, and water management planning.
        </p>
        <Button urlPath="/levels" text="View Current Levels" />
      </div>
    </div>
    <div class="flex justify-center items-center p-4 h-full">
      <div class="mt-2 ml-2 hidden sm:block w-4/5 h-4/5">
        <!-- River Gauge Visualization -->
        <div class="bg-primaryGray/20 backdrop-blur-sm rounded-2xl p-8 border border-primaryWhite/20">
          <div class="space-y-6">
            <!-- Wigwam River -->
            <div class="bg-primaryGray/40 rounded-xl p-6 border border-primaryTeal/30">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-primaryWhite font-semibold text-lg">Wigwam River</h3>
                <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm">Normal</span>
              </div>
              <div class="text-3xl font-bold text-primaryTeal mb-2">4.2 ft</div>
              <div class="h-2 bg-secondaryGray rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-primaryTeal to-primaryBlue rounded-full" style="width: 42%"></div>
              </div>
            </div>

            <!-- Pine Creek -->
            <div class="bg-primaryGray/40 rounded-xl p-6 border border-yellow-500/30">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-primaryWhite font-semibold text-lg">Pine Creek</h3>
                <span class="px-3 py-1 bg-yellow-500/20 text-yellow-300 rounded-full text-sm">Watch</span>
              </div>
              <div class="text-3xl font-bold text-yellow-400 mb-2">6.8 ft</div>
              <div class="h-2 bg-secondaryGray rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-yellow-400 to-yellow-500 rounded-full" style="width: 68%"></div>
              </div>
            </div>

            <!-- Mill River -->
            <div class="bg-primaryGray/40 rounded-xl p-6 border border-primaryTeal/30">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-primaryWhite font-semibold text-lg">Mill River</h3>
                <span class="px-3 py-1 bg-green-500/20 text-green-300 rounded-full text-sm">Normal</span>
              </div>
              <div class="text-3xl font-bold text-primaryTeal mb-2">3.1 ft</div>
              <div class="h-2 bg-secondaryGray rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-primaryTeal to-primaryBlue rounded-full" style="width: 31%"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
