---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import PlotlyChart from '../../components/PlotlyChart.astro';

const { river } = Astro.params;

let currentLevel: number | null = null;
let error: string | null = null;
let transmitTime: string | null = null;

let historicalData: any = null;
let chartData: any = null;
let change24h: number | null = null;
let monthlyAvg: number | null = null;

try {
  const context = import.meta.env.CONTEXT || 'production';
  const apiUrl = context === 'dev' ? 'http://localhost:8888' : 'https://digitalflowgauge.com';

  try {
    const latestResponse = await fetch(`${apiUrl}/latestlevels?${river}`);
    if (latestResponse.ok) {
      const latestData = await latestResponse.json();
      if (latestData?.metadata?.transmitTime?.local) {
        transmitTime = latestData.metadata.transmitTime.local;
      }
    }
  } catch (e) {
    console.warn('Failed to fetch latest levels metadata:', e);
  }

  const historicalResponse = await fetch(`${apiUrl}/historicallevels?${river}`);
  if (historicalResponse.ok) {
    historicalData = await historicalResponse.json();

    if (historicalData?.data) {
      const dates: string[] = [];
      const levels: number[] = [];

      for (const year in historicalData.data) {
        for (const month in historicalData.data[year]) {
          for (const date in historicalData.data[year][month]) {
            for (const hour in historicalData.data[year][month][date]) {
              const level = historicalData.data[year][month][date][hour];
              const dateTime = `${date} ${hour}:00`;
              dates.push(dateTime);
              levels.push(typeof level === 'number' ? level : parseInt(level.toString()));
            }
          }
        }
      }

      if (dates.length > 0) {
        const combined = dates.map((date, i) => ({ date: new Date(date), level: levels[i] }))
          .sort((a, b) => a.date.getTime() - b.date.getTime());

        const mostRecentReading = combined[combined.length - 1];
        currentLevel = mostRecentReading.level;

        chartData = {
          x: combined.map(item => item.date.toISOString()),
          y: combined.map(item => item.level),
          type: 'scatter',
          mode: 'lines+markers',
          name: 'Water Level',
          line: { color: '#06B6D4', width: 2 },
          marker: { color: '#22D3EE', size: 4 },
          fill: 'tozeroy',
          fillcolor: 'rgba(6, 182, 212, 0.08)'
        };

        if (combined.length >= 2 && currentLevel !== null) {
          const mostRecentTime = mostRecentReading.date;
          const exactlyOneDayBefore = new Date(mostRecentTime.getTime() - 24 * 60 * 60 * 1000);
          let closest24hReading = combined[0];
          let minDiff = Math.abs(combined[0].date.getTime() - exactlyOneDayBefore.getTime());

          for (const reading of combined) {
            const diff = Math.abs(reading.date.getTime() - exactlyOneDayBefore.getTime());
            if (diff < minDiff) {
              minDiff = diff;
              closest24hReading = reading;
            }
          }

          change24h = currentLevel - closest24hReading.level;
        }

        const now = new Date();
        const currentMonth = now.getMonth();
        const currentYear = now.getFullYear();

        const monthReadings = combined.filter(reading => {
          return reading.date.getMonth() === currentMonth &&
                 reading.date.getFullYear() === currentYear;
        });

        if (monthReadings.length > 0) {
          const sum = monthReadings.reduce((acc, reading) => acc + reading.level, 0);
          monthlyAvg = Math.round(sum / monthReadings.length);
        }
      }
    }
  }
} catch (e: any) {
  error = e.message;
}

const riverNames: Record<string, string> = {
  'wigwam': 'Wigwam River',
  'pine-creek': 'Pine Creek',
  'mill-river': 'Mill River'
};

const riverName = river ? (riverNames[river] || river) : 'Unknown River';

const getStatus = (level: number) => {
  if (level > 150) return { status: 'High', color: 'high' };
  if (level >= 100) return { status: 'Running', color: 'running' };
  return { status: 'Low', color: 'low' };
};

const statusInfo = currentLevel ? getStatus(currentLevel) : { status: 'Unknown', color: 'gray' };
---

<Layout
  pageTitle={`${riverName} - Current Level`}
  pageDescription={`Real-time water level monitoring for ${riverName}. Current level: ${currentLevel || 'Loading...'}cm`}
>
  <div class="scan-pattern min-h-screen">
    <div class="max-w-5xl mx-auto px-6 py-12">

      <!-- Back Navigation -->
      <div class="mb-10 animate-fade-up">
        <a href="/levels" class="inline-flex items-center gap-2 font-body text-sm font-medium text-accent hover:text-accentLight transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path>
          </svg>
          All Sensors
        </a>
      </div>

      <!-- River Header -->
      <div class="mb-12 animate-fade-up delay-1">
        <p class="font-mono text-[10px] text-accent/60 mb-2">SENSOR-001</p>
        <h1 class="font-display text-4xl lg:text-6xl font-bold text-text tracking-tight">
          {riverName}
        </h1>
      </div>

      <!-- Current Level Display -->
      <div class="card p-10 mb-10 relative overflow-hidden animate-fade-up delay-2">
        <!-- Top glow -->
        <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

        {currentLevel !== null ? (
          <div class="flex flex-col lg:flex-row items-center lg:items-end justify-between gap-8">
            <!-- Level reading -->
            <div class="text-center lg:text-left">
              <span class={`inline-block font-mono text-xs px-3 py-1.5 rounded-md border mb-6 ${
                statusInfo.color === 'running' ? 'status-bg-running status-running' :
                statusInfo.color === 'low' ? 'status-bg-low status-low' :
                statusInfo.color === 'high' ? 'status-bg-high status-high' :
                'bg-surfaceHover text-textDim border-border'
              }`}>
                {statusInfo.status}
              </span>

              <div class="flex items-baseline gap-3">
                <span class={`font-mono text-8xl lg:text-9xl font-medium tracking-tighter leading-none ${
                  statusInfo.color === 'running' ? 'text-signal' :
                  statusInfo.color === 'low' ? 'text-warning' :
                  statusInfo.color === 'high' ? 'text-danger' :
                  'text-textMuted'
                }`}>
                  {currentLevel}
                </span>
                <span class="font-body text-2xl text-textMuted">cm</span>
              </div>
            </div>

            <!-- Level gauge visualization -->
            <div class="w-full lg:w-80">
              <div class="mb-4">
                <div class="level-bar" style="height: 10px;">
                  <div
                    class={`level-bar-fill ${
                      statusInfo.color === 'running' ? 'bg-signal' :
                      statusInfo.color === 'low' ? 'bg-warning' :
                      statusInfo.color === 'high' ? 'bg-danger' :
                      'bg-textDim'
                    }`}
                    style={`width: ${Math.min((currentLevel / 200) * 100, 100)}%`}
                  ></div>
                </div>
                <div class="flex justify-between mt-2">
                  <span class="font-mono text-[10px] text-textDim">0 cm</span>
                  <span class="font-mono text-[10px] text-warning/60">100</span>
                  <span class="font-mono text-[10px] text-danger/60">150</span>
                  <span class="font-mono text-[10px] text-textDim">200 cm</span>
                </div>
              </div>
              <p class="font-mono text-[11px] text-textDim text-right">
                Uplink interval: 12h &middot; {transmitTime || 'Unknown'} MST
              </p>
            </div>
          </div>
        ) : (
          <div class="text-center py-12">
            {error ? (
              <>
                <h2 class="font-display text-2xl text-danger mb-2">Error Loading Data</h2>
                <p class="font-body text-textMuted">{error}</p>
              </>
            ) : (
              <>
                <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-accent mx-auto mb-4"></div>
                <p class="font-body text-textMuted">Loading sensor data...</p>
              </>
            )}
          </div>
        )}
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10 animate-fade-up delay-3">
        <!-- 24h Change -->
        <div class="card p-6">
          <p class="font-mono text-[10px] text-textDim mb-3">24H DELTA</p>
          {change24h !== null ? (
            <>
              <div class={`font-mono text-3xl font-medium ${
                change24h > 0 ? 'text-signal' :
                change24h < 0 ? 'text-danger' :
                'text-text'
              }`}>
                {change24h > 0 ? '+' : ''}{change24h}
                <span class="font-body text-sm text-textMuted ml-1">cm</span>
              </div>
              <p class="font-body text-xs text-textDim mt-1">vs. previous reading</p>
            </>
          ) : (
            <div class="font-mono text-3xl text-textDim">N/A</div>
          )}
        </div>

        <!-- Monthly Average -->
        <div class="card p-6">
          <p class="font-mono text-[10px] text-textDim mb-3">MONTHLY AVG</p>
          {monthlyAvg !== null ? (
            <>
              <div class="font-mono text-3xl font-medium text-accent">
                {monthlyAvg}
                <span class="font-body text-sm text-textMuted ml-1">cm</span>
              </div>
              <p class="font-body text-xs text-textDim mt-1">{new Date().toLocaleString('default', { month: 'long' })} computed</p>
            </>
          ) : (
            <div class="font-mono text-3xl text-textDim">N/A</div>
          )}
        </div>

        <!-- Alert Level -->
        <div class="card p-6">
          <p class="font-mono text-[10px] text-textDim mb-3">ALERT THRESHOLD</p>
          <div class="font-mono text-3xl font-medium text-danger">
            150
            <span class="font-body text-sm text-textMuted ml-1">cm</span>
          </div>
          <p class="font-body text-xs text-textDim mt-1">Trigger level</p>
        </div>
      </div>

      <!-- Historical Chart -->
      {chartData && (
        <div class="card p-8 mb-10 animate-fade-up delay-4">
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-display text-xl font-semibold text-text">Historical Data</h2>
            <span class="font-mono text-[10px] text-textDim">Pan & zoom enabled</span>
          </div>
          <PlotlyChart chartData={chartData} />
        </div>
      )}

      <!-- Location Map -->
      <div class="card p-8 mb-10 animate-fade-up delay-5">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-display text-xl font-semibold text-text">Sensor Location</h2>
          <span class="font-mono text-[10px] text-textDim">49.28&deg;N, 114.95&deg;W</span>
        </div>
        <div id="map" class="w-full h-80 rounded-lg overflow-hidden border border-border"></div>
      </div>
    </div>
  </div>
</Layout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  function initMap() {
    if (typeof L !== 'undefined') {
      const map = L.map('map').setView([49.284336, -114.954499], 13);

      L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/attributions">CARTO</a>',
        maxZoom: 19
      }).addTo(map);

      const marker = L.marker([49.284336, -114.954499]).addTo(map);
      marker.bindPopup('<div style="text-align: center; font-family: Space Grotesk, sans-serif;"><span style="color: #06B6D4; font-weight: 600; font-size: 15px;">Wigwam River</span><br><span style="color: #94A3B8; font-family: JetBrains Mono, monospace; font-size: 10px;">SENSOR-001</span></div>').openPopup();
    } else {
      setTimeout(initMap, 100);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }

  setInterval(() => {
    window.location.reload();
  }, 5 * 60 * 1000);
</script>

<style>
  #map {
    background-color: #0A0E17 !important;
  }

  :global(.leaflet-control-zoom a) {
    background-color: rgba(22, 31, 48, 0.95) !important;
    color: #06B6D4 !important;
    border: 1px solid rgba(30, 41, 59, 0.8) !important;
  }

  :global(.leaflet-control-zoom a:hover) {
    background-color: rgba(6, 182, 212, 0.15) !important;
    color: #22D3EE !important;
  }

  :global(.leaflet-popup-content-wrapper) {
    background-color: rgba(22, 31, 48, 0.97) !important;
    color: #E2E8F0 !important;
    border: 1px solid rgba(6, 182, 212, 0.2) !important;
    border-radius: 8px !important;
    box-shadow: 0 0 20px rgba(6, 182, 212, 0.1), 0 4px 20px rgba(0, 0, 0, 0.3) !important;
  }

  :global(.leaflet-popup-tip) {
    background-color: rgba(22, 31, 48, 0.97) !important;
  }

  :global(.leaflet-popup-close-button) {
    color: #64748B !important;
  }

  :global(.leaflet-popup-close-button:hover) {
    color: #06B6D4 !important;
  }

  :global(.leaflet-control-attribution) {
    background-color: rgba(10, 14, 23, 0.8) !important;
    color: #64748B !important;
    font-family: 'JetBrains Mono', monospace !important;
    font-size: 9px !important;
  }

  :global(.leaflet-control-attribution a) {
    color: #06B6D4 !important;
  }
</style>
