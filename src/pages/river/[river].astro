---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';

const { river } = Astro.params;

// Fetch latest levels data
let latestData: any = null;
let currentLevel: number | null = null;
let error: string | null = null;

try {
  // Use the correct API URL for local development
  const apiUrl = import.meta.env.DEV ? 'http://localhost:52736' : (Astro.site || 'https://your-site.netlify.app');
  const response = await fetch(`${apiUrl}/latestlevels?${river}`);
  if (response.ok) {
    latestData = await response.json();
    // Get the first value from the levels object and parse the number
    if (latestData?.levels && typeof latestData.levels === 'object') {
      const levelValues = Object.values(latestData.levels);
      if (levelValues.length > 0) {
        const levelString = levelValues[0] as string;
        currentLevel = parseInt(levelString.replace('cm', ''));
      }
    }
  }
} catch (e: any) {
  error = e.message;
  // Fallback data for development
  if (river === 'wigwam') {
    currentLevel = 35; // 35cm as requested
  }
}

// River display names
const riverNames: Record<string, string> = {
  'wigwam': 'Wigwam River',
  'pine-creek': 'Pine Creek',
  'mill-river': 'Mill River'
};

const riverName = river ? (riverNames[river] || river) : 'Unknown River';

// Determine status based on level
const getStatus = (level) => {
  if (level > 80) return { status: 'High', color: 'red' };
  if (level > 60) return { status: 'Watch', color: 'yellow' };
  if (level < 20) return { status: 'Low', color: 'blue' };
  return { status: 'Normal', color: 'green' };
};

const statusInfo = currentLevel ? getStatus(currentLevel) : { status: 'Unknown', color: 'gray' };
---

<Layout
  pageTitle={`${riverName} - Current Level`}
  pageDescription={`Real-time water level monitoring for ${riverName}. Current level: ${currentLevel || 'Loading...'}cm`}
>
  <div class="container mx-auto px-6 py-8">
    <!-- Back Navigation -->
    <div class="mb-8">
      <a 
        href="/levels" 
        class="inline-flex items-center text-primaryTeal hover:text-primaryBlue transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to All Levels
      </a>
    </div>

    <!-- Main Content -->
    <div class="max-w-4xl mx-auto">
      <!-- River Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-4">
          {riverName}
        </h1>
        <p class="text-xl text-primaryWhite">
          Real-time water level monitoring
        </p>
      </div>

      <!-- Current Level Display -->
      <div class="bg-primaryGray/40 backdrop-blur-sm rounded-2xl p-12 border border-primaryWhite/20 text-center mb-8">
        {currentLevel !== null ? (
          <>
            <div class="mb-6">
              <span class={`px-4 py-2 rounded-full text-lg font-medium ${
                statusInfo.color === 'green' ? 'bg-green-500/20 text-green-300' :
                statusInfo.color === 'yellow' ? 'bg-yellow-500/20 text-yellow-300' :
                statusInfo.color === 'red' ? 'bg-red-500/20 text-red-300' :
                statusInfo.color === 'blue' ? 'bg-blue-500/20 text-blue-300' :
                'bg-gray-500/20 text-gray-300'
              }`}>
                {statusInfo.status}
              </span>
            </div>
            
            <!-- Big Level Display -->
            <div class={`text-8xl lg:text-9xl font-bold mb-4 ${
              statusInfo.color === 'green' ? 'text-primaryTeal' :
              statusInfo.color === 'yellow' ? 'text-yellow-400' :
              statusInfo.color === 'red' ? 'text-red-400' :
              statusInfo.color === 'blue' ? 'text-blue-400' :
              'text-gray-400'
            }`}>
              {currentLevel}
              <span class="text-4xl lg:text-5xl text-primaryWhite ml-2">cm</span>
            </div>
            
            <p class="text-primaryWhite/70 text-lg">
              Last updated: {new Date().toLocaleString()}
            </p>
          </>
        ) : (
          <div class="text-center">
            {error ? (
              <>
                <div class="text-6xl text-red-400 mb-4">⚠️</div>
                <h2 class="text-2xl text-red-300 mb-2">Error Loading Data</h2>
                <p class="text-primaryWhite/70">{error}</p>
              </>
            ) : (
              <>
                <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-primaryTeal mx-auto mb-4"></div>
                <p class="text-primaryWhite text-xl">Loading current level...</p>
              </>
            )}
          </div>
        )}
      </div>

      <!-- Additional Info Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- 24 Hour Change -->
        <div class="bg-primaryGray/30 backdrop-blur-sm rounded-xl p-6 border border-primaryWhite/10">
          <h3 class="text-primaryWhite font-semibold text-lg mb-2">24h Change</h3>
          <div class="text-2xl font-bold text-primaryTeal">+2.3 cm</div>
          <p class="text-sm text-primaryWhite/60">Since yesterday</p>
        </div>

        <!-- Average Level -->
        <div class="bg-primaryGray/30 backdrop-blur-sm rounded-xl p-6 border border-primaryWhite/10">
          <h3 class="text-primaryWhite font-semibold text-lg mb-2">Monthly Avg</h3>
          <div class="text-2xl font-bold text-primaryTeal">32.1 cm</div>
          <p class="text-sm text-primaryWhite/60">October average</p>
        </div>

        <!-- Alert Level -->
        <div class="bg-primaryGray/30 backdrop-blur-sm rounded-xl p-6 border border-primaryWhite/10">
          <h3 class="text-primaryWhite font-semibold text-lg mb-2">Alert Level</h3>
          <div class="text-2xl font-bold text-yellow-400">85 cm</div>
          <p class="text-sm text-primaryWhite/60">Flood warning</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a 
          href={`/historical?river=${river}`}
          class="bg-primaryTeal hover:bg-primaryBlue text-white px-8 py-3 rounded-lg font-semibold transition-colors text-center"
        >
          View Historical Data
        </a>
        <a 
          href={`/alerts?river=${river}`}
          class="border border-primaryTeal text-primaryTeal hover:bg-primaryTeal hover:text-white px-8 py-3 rounded-lg font-semibold transition-colors text-center"
        >
          Set Up Alerts
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Auto-refresh every 5 minutes
  setInterval(() => {
    window.location.reload();
  }, 5 * 60 * 1000);
</script>
