---
import logo from '../assets/images/logo.svg';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "River Gauge Monitoring System" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-white flex flex-col font-sans antialiased">
    <!-- Header -->
    <header class="border-b border-gray-200 bg-white/80 backdrop-blur-sm sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <nav class="flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <img src={logo.src} alt="River Gauge Logo" class="w-20 h-20" />
          </div>
          <nav class="hidden md:flex items-center space-x-8">
            <a href="/" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Home</a>
            <a href="/levels" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Current Levels</a>
            <a href="/historical" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">Historical Data</a>
            <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors text-sm font-medium">About</a>
          </nav>
          <div class="flex items-center space-x-4">
            <button class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
              Get Started
            </button>
          </div>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-200 bg-gray-50">
      <div class="max-w-7xl mx-auto px-6 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="col-span-1 md:col-span-2">
            <div class="flex items-center space-x-3 mb-4">
              <img src={logo.src} alt="digital flow gauge Logo" class="w-20 h-20" />
            </div>
            <p class="text-gray-600 text-sm max-w-md">
              Real-time and historical river level monitoring system providing accurate water level data for safety and planning.
            </p>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-4">Product</h3>
            <ul class="space-y-3 text-sm text-gray-600">
              <li><a href="/levels" class="hover:text-gray-900 transition-colors">Current Levels</a></li>
              <li><a href="/historical" class="hover:text-gray-900 transition-colors">Historical Data</a></li>
              <li><a href="/alerts" class="hover:text-gray-900 transition-colors">Alerts</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-gray-900 mb-4">Company</h3>
            <ul class="space-y-3 text-sm text-gray-600">
              <li><a href="/about" class="hover:text-gray-900 transition-colors">About</a></li>
              <li><a href="/contact" class="hover:text-gray-900 transition-colors">Contact</a></li>
              <li><a href="/support" class="hover:text-gray-900 transition-colors">Support</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 mt-12 pt-8 text-center">
          <p class="text-sm text-gray-500">&copy; 2024 River Gauge Monitor. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
